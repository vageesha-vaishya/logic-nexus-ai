# /srv/logic-nexus/.env
#
# Copy this file to /srv/logic-nexus/.env, fill in your values, and chmod 600.
# Both the Vite build and the markets-worker systemd unit read from this file.
#
# Anything starting with VITE_ is baked into the frontend bundle at build
# time — do NOT put server-only secrets in a VITE_ var.

# ── Supabase ────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT
VITE_SUPABASE_ANON_KEY=eyJ...
VITE_SUPABASE_PUBLISHABLE_KEY=eyJ...

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_DB_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
SUPABASE_ACCESS_TOKEN=sbp_...

# ── Markets worker ──────────────────────────────────────────────────────────
# In production Nginx reverse-proxies /api/markets-worker/* → 127.0.0.1:8001
VITE_MARKETS_WORKER_URL=/api/markets-worker
VITE_MARKETS_WORKER_TARGET=http://127.0.0.1:8001
MARKETS_WORKER_HOST=127.0.0.1
MARKETS_WORKER_PORT=8001

# ── LLM gateway (pick one; multiple is fine) ────────────────────────────────
OPENROUTER_API_KEY=sk-or-...
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Vite needs this too if you call OpenAI directly from the browser. If you
# don't, leave it unset — the browser doesn't need an OpenAI key.
VITE_OPENAI_API_KEY=

# ── Razorpay (T3 Billing) ───────────────────────────────────────────────────
# T3 Billing is built (see project memory) but needs live keys.
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=

# ── Optional: Sentry / PostHog (frontend disables itself if absent) ─────────
VITE_SENTRY_DSN=
VITE_POSTHOG_KEY=
