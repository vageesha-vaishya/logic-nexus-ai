# deploy/selfhosted-supabase/.env
#
# Copy this file to deploy/selfhosted-supabase/.env on the Coolify host (or
# fill it in as Coolify's own env-var UI for this compose resource — see
# README.md), fill in real values, and never commit the filled copy.
#
# This mirrors the existing deploy/env.example convention used for the
# legacy systemd-based deployment path in this repo.
#
# Phase 1 scope: this stack has zero production traffic (see
# docs/superpowers/specs/2026-08-22-supabase-selfhost-phase1-design.md).
# Secrets below can be freshly generated for Phase 1 — aligning them with
# Supabase Cloud's real secrets is a later migration phase, not this one.

# ── Postgres (the `db` service, in this same compose file — Task 2) ─────────
# Postgres is reached internally by every other service at the literal
# hostname db:5432 (not externally injected — no POSTGRES_HOST/POSTGRES_PORT
# here anymore; the `db` service's own container port is hardcoded to 5432
# in docker-compose.yml).
# Password for every Postgres role this stack uses (postgres, supabase_admin,
# authenticator, supabase_auth_admin, supabase_storage_admin, etc. — set by
# volumes/db/roles.sql on first init). Pick one long random value.
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD
# Database name (Supabase's own init scripts assume "postgres").
POSTGRES_DB=postgres

# ── JWT / API keys ───────────────────────────────────────────────────────────
# Legacy symmetric HS256 signing secret. Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
# Seconds until an issued access token expires.
JWT_EXPIRY=3600
# Legacy HS256-signed JWT for the `anon` role. Generate with utils/generate-keys.sh
# from the upstream supabase/supabase repo (docker/utils/generate-keys.sh), signed
# with the JWT_SECRET above.
ANON_KEY=REPLACE_WITH_ANON_ROLE_JWT
# Legacy HS256-signed JWT for the `service_role` role. Keep this server-side only.
SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_JWT
# Optional: newer opaque API keys (sb_publishable_.../sb_secret_...). Leave blank
# to use only the legacy ANON_KEY/SERVICE_ROLE_KEY JWTs above.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Optional: pre-signed ES256 JWTs paired with the opaque keys above. Leave blank
# unless SUPABASE_PUBLISHABLE_KEY/SUPABASE_SECRET_KEY are set.
ANON_KEY_ASYMMETRIC=
SERVICE_ROLE_KEY_ASYMMETRIC=
# Optional: JWKS for token verification (PostgREST/Storage/Realtime). Leave
# blank to fall back to the symmetric JWT_SECRET above.
JWT_JWKS=

# ── URLs ─────────────────────────────────────────────────────────────────────
# Public URL of the Kong gateway once Task 4 wires up Coolify/Traefik routing.
SUPABASE_PUBLIC_URL=https://supabase.sosservices.online
# Full external URL of the Auth service (used for OAuth callbacks/email links).
API_EXTERNAL_URL=https://supabase.sosservices.online/auth/v1
# Frontend "Site URL" GoTrue redirects to after auth flows.
SITE_URL=https://app.sosservices.online
# Comma-separated extra allowed redirect URLs (optional).
ADDITIONAL_REDIRECT_URLS=
# Set to true to disable new-user signup at the Auth layer.
DISABLE_SIGNUP=false

# ── Auth behavior ────────────────────────────────────────────────────────────
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
MAILER_URLPATHS_INVITE="/auth/v1/verify"
MAILER_URLPATHS_CONFIRMATION="/auth/v1/verify"
MAILER_URLPATHS_RECOVERY="/auth/v1/verify"
MAILER_URLPATHS_EMAIL_CHANGE="/auth/v1/verify"
# SMTP is not exercised in Phase 1 (no signups yet) — placeholders are enough
# for GoTrue to start; wire a real SMTP provider before any real traffic.
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=2500
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASS
SMTP_SENDER_NAME=Logic Nexus AI

# ── PostgREST ────────────────────────────────────────────────────────────────
# Schemas exposed via the REST API.
PGRST_DB_SCHEMAS=public,graphql_public
# Max rows returned per request.
PGRST_DB_MAX_ROWS=1000
# Extra schemas added to every request's search_path.
PGRST_DB_EXTRA_SEARCH_PATH=public

# ── Storage (local-disk backend — no MinIO/S3 in Phase 1) ───────────────────
# Directory name under the storage volume used as the default bucket root.
GLOBAL_S3_BUCKET=stub
# Used for S3-protocol endpoint metadata even on the file backend; stub is fine.
REGION=stub
# Equivalent to a Supabase project ref.
STORAGE_TENANT_ID=stub

# ── Realtime ─────────────────────────────────────────────────────────────────
# Must be >= 64 chars. Generate with: openssl rand -base64 48
SECRET_KEY_BASE=REPLACE_WITH_64_CHAR_MINIMUM_SECRET
# Must be exactly 16 chars. Generate with: openssl rand -hex 8
REALTIME_DB_ENC_KEY=REPLACE_16CHAR

# ── Edge Runtime ─────────────────────────────────────────────────────────────
# Phase 1 deploys no real functions yet — VERIFY_JWT only matters once
# deploy/selfhosted-supabase/volumes/functions/ has content (later phase).
FUNCTIONS_VERIFY_JWT=false

# Phase 4 Batch 2: LLM provider keys for Edge Functions needing AI capabilities.
# Leave any of these blank if not yet provisioned — docker-compose.yml defaults
# each to empty (${VAR:-}), so an unset key doesn't break compose validation;
# it just leaves the functions that require it non-functional until supplied.
OPENAI_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_REST_URL=

# ── Kong / gateway ───────────────────────────────────────────────────────────
# Host port Kong's HTTP listener binds to.
KONG_HTTP_PORT=8000
