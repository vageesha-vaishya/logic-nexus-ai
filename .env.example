# Logic Nexus AI - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Supabase
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_ANON_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_ANON_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
SUPABASE_ACCESS_TOKEN="your-access-token"
AMRO_SUPABASE_URL="https://your-project-id.supabase.co"
AMRO_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database
DATABASE_URL="postgresql://postgres.your-project-id:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.your-project-id:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
SUPABASE_DB_URL="postgresql://postgres.your-project-id:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# External APIs
GOOGLE_API_KEY="your-google-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Upstash Redis — distributed rate limiting for Edge Functions
# Create a free database at console.upstash.com → copy REST URL + token
# Edge Functions will FAIL OPEN (allow all) if these are not set.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Monitoring (optional)
VITE_SENTRY_DSN="your-sentry-dsn"
VITE_POSTHOG_KEY="your-posthog-key"

# AMRO Module Configuration
AMRO_ENABLED=true
AMRO_FEATURE_FLAG="amro-pilot-phase-a"
AMRO_MAX_CONCURRENT_WORK_PACKAGES=100
AMRO_MAINTENANCE_EVENT_RETENTION_DAYS=3650

# AMRO Regulatory Configuration
AMRO_REGULATORY_AUTHORITY="FAA"
AMRO_COMPLIANCE_LEVEL="Part11"
AMRO_AUDIT_TRAIL_SIGNING=true

# AMRO Integration Endpoints
AMRO_KAFKA_BROKER="localhost:9092"
AMRO_KAFKA_TOPIC_PREFIX="amro"
AMRO_MQTT_BROKER="mqtt://localhost:1883"
AMRO_MQTT_TOPIC_PREFIX="amro/twin"

# AMRO Digital Twin
AMRO_TWIN_SYNC_INTERVAL_MS=500
AMRO_TWIN_OFFLINE_CACHE_DAYS=30

# AMRO Predictive Analytics
AMRO_AI_PROVIDER="openai"
AMRO_FAILURE_MODE_MODEL_ID="amro-fm-v1"
AMRO_PREDICTION_CONFIDENCE_THRESHOLD=0.75

# AMRO API Frontend Integration
VITE_AMRO_API_BASE_URL="/api/amro"
VITE_AMRO_API_PROXY_TARGET="http://localhost:3001"
VITE_UIM_API_BASE_URL="/api/v2/uim"
VITE_UIM_API_PROXY_TARGET="http://localhost:3000"
VITE_UIM_API_PROXY_TARGET_REMOTE=""
VITE_TENANT_BRANDING_PROXY_TARGET="http://localhost:8787"
VITE_AMRO_DEFAULT_AIRCRAFT_ID="ac-default-001"
