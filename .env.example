# Logic Nexus AI - Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# Supabase — this project runs a self-hosted Supabase stack (Kong + GoTrue +
# PostgREST + Realtime + Storage + Postgres on the project's own Coolify VPS),
# not Supabase Cloud. SUPABASE_URL/VITE_SUPABASE_URL below is the real,
# reachable API gateway domain; ANON/PUBLISHABLE/SERVICE_ROLE_KEY are still
# per-deployment secrets — get the real values from the running stack (e.g.
# the self-hosted db container's own resolved env), never invent or reuse a
# Cloud project's keys here.
#
# VITE_SUPABASE_PROJECT_ID is a Supabase Cloud Management API concept
# (`supabase gen types --project-id` / `functions deploy --project-ref`) with
# no self-hosted equivalent — db-types:generate:core, supabase:types:gen, and
# supabase:functions:deploy will NOT target the self-hosted stack via this
# value; type generation against self-hosted needs `--db-url` instead, and
# self-hosted has no functions-deploy API (the functions container is a plain
# docker-compose service). Only fill this in if you still need Cloud-project
# CLI tooling for some other purpose.
VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
VITE_SUPABASE_ANON_KEY="sb_publishable_xxx"
VITE_SUPABASE_URL="https://supabase.yourdomain.example"
SUPABASE_URL="https://supabase.yourdomain.example"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_xxx"
SUPABASE_ANON_KEY="sb_publishable_xxx"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Cloud Management API personal access token (`supabase login`) — no
# self-hosted equivalent; only needed if you also use a Cloud project.
SUPABASE_ACCESS_TOKEN="your-access-token"
# Same self-hosted instance as SUPABASE_URL/SUPABASE_SERVICE_ROLE_KEY above —
# amro-api just reads its own env var names.
AMRO_SUPABASE_URL="https://supabase.yourdomain.example"
AMRO_SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Database. For this project's self-hosted stack, `db` is the Docker Compose
# service's stable network alias and only resolves from inside that VPS's
# own Docker network — it will NOT work as a DATABASE_URL host from your
# local machine unless you're running the script over SSH on the VPS, or via
# a tunnel. (If you're instead pointing at Supabase Cloud, use its pooler
# host/port as shown in the commented example below.)
DATABASE_URL="postgresql://supabase_admin:YOUR_PASSWORD@db:5432/postgres"
DIRECT_URL="postgresql://supabase_admin:YOUR_PASSWORD@db:5432/postgres"
SUPABASE_DB_URL="postgresql://supabase_admin:YOUR_PASSWORD@db:5432/postgres"
# Supabase Cloud pooler equivalent, for reference:
# DATABASE_URL="postgresql://postgres.your-project-id:YOUR_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"

# External APIs
GOOGLE_API_KEY="your-google-api-key"
OPENAI_API_KEY="your-openai-api-key"

# Upstash Redis — distributed rate limiting for Edge Functions
# Create a free database at console.upstash.com → copy REST URL + token
# Edge Functions will FAIL OPEN (allow all) if these are not set.
UPSTASH_REDIS_REST_URL="https://your-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-rest-token"

# Monitoring (optional)
VITE_SENTRY_DSN="your-sentry-dsn"
VITE_POSTHOG_KEY="your-posthog-key"

# AMRO Module Configuration
AMRO_ENABLED=true
AMRO_FEATURE_FLAG="amro-pilot-phase-a"
AMRO_MAX_CONCURRENT_WORK_PACKAGES=100
AMRO_MAINTENANCE_EVENT_RETENTION_DAYS=3650

# AMRO Regulatory Configuration
AMRO_REGULATORY_AUTHORITY="FAA"
AMRO_COMPLIANCE_LEVEL="Part11"
AMRO_AUDIT_TRAIL_SIGNING=true

# AMRO Integration Endpoints
AMRO_KAFKA_BROKER="localhost:9092"
AMRO_KAFKA_TOPIC_PREFIX="amro"
AMRO_MQTT_BROKER="mqtt://localhost:1883"
AMRO_MQTT_TOPIC_PREFIX="amro/twin"

# AMRO Digital Twin
AMRO_TWIN_SYNC_INTERVAL_MS=500
AMRO_TWIN_OFFLINE_CACHE_DAYS=30

# AMRO Predictive Analytics
AMRO_AI_PROVIDER="openai"
AMRO_FAILURE_MODE_MODEL_ID="amro-fm-v1"
AMRO_PREDICTION_CONFIDENCE_THRESHOLD=0.75

# AMRO API Frontend Integration
VITE_AMRO_API_BASE_URL="/api/amro"
VITE_AMRO_API_PROXY_TARGET="http://localhost:3001"
VITE_UIM_API_BASE_URL="/api/v2/uim"
VITE_UIM_API_PROXY_TARGET="http://localhost:3000"
VITE_UIM_API_PROXY_TARGET_REMOTE=""
VITE_TENANT_BRANDING_PROXY_TARGET="http://localhost:8787"
VITE_AMRO_DEFAULT_AIRCRAFT_ID="ac-default-001"
