4\">\n          {/* Navigation and Actions */}\n          <div className=\"flex flex-wrap items-center justify-between gap-4\">\n            <div className=\"flex items-center gap-2\">\n              <Button variant=\"ghost\" size=\"sm\" asChild>\n                <Link to=\"/dashboard/amro/work-packages\">\n                  <ArrowLeft className=\"mr-2 h-4 w-4\" />\n                  Back to Work Packages\n                </Link>\n              </Button>\n              <Separator orientation=\"vertical\" className=\"h-6\" />\n              <StatusBadge status={wp.status} />\n              {wp.priority <= 2 && (\n                <Badge variant=\"destructive\">P{wp.priority} - {wp.priority === 1 ? 'Critical' : 'High'}</Badge>\n              )}\n            </div>\n            <div className=\"flex items-center gap-2\">\n              <Button \n                variant=\"outline\" \n                size=\"sm\" \n                onClick={() => setEditDialogOpen(true)}\n                aria-label=\"Edit work package details\"\n              >\n                <Pencil className=\"mr-2 h-4 w-4\" />\n                Edit\n              </Button>\n              <DropdownMenu>\n                <DropdownMenuTrigger asChild>\n                  <Button variant=\"outline\" size=\"icon\">\n                    <MoreHorizontal className=\"h-4 w-4\" />\n                  </Button>\n                </DropdownMenuTrigger>\n                <DropdownMenuContent align=\"end\">\n                  <DropdownMenuItem onClick={() => handleClone(wp)}>\n                    <Copy className=\"mr-2 h-4 w-4\" />\n                    Clone Work Package\n                  </DropdownMenuItem>\n                  <DropdownMenuItem onClick={() => window.print()}>\n                    <Printer className=\"mr-2 h-4 w-4\" />\n                    Print\n                  </DropdownMenuItem>\n                  <DropdownMenuItem onClick={()", "is_member_call": false, "source_file": "/Users/vims/Downloads/Develop