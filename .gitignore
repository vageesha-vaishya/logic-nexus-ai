supabase/migration-package/new-supabase-config.env
supabase/migration-package/new-supabase-config*.env
supabase/migration-package/direct-migration/migration.env*
migration.env

# Git worktrees (isolated development workspaces)
.worktrees

# Project rules workflow runtime state
.trae/rules/.consultation-state.json
.trae/rules/generated/

# Capacitor / Android (Phase 1 Addendum T24)
# The android/ source tree itself IS checked in so CI can rebuild the APK,
# but build artifacts and machine-local SDK pointers stay out of git.
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/captures/
android/.idea/
android/app/release/
android/app/debug/
# Local-only Capacitor overrides (live-reload dev server URL etc.)
capacitor.config.local.ts

# Firebase / GCP service-account JSON keys — NEVER commit.
# The downloaded file from Firebase Console contains a private RSA key.
# Pattern matches the Firebase Admin SDK default filename (firebase-adminsdk-*).
# google-services.json is the public Android config (no private key) — that
# one IS safe to commit, so we explicitly include it via a negation below.
**/firebase-adminsdk-*.json
**/*-firebase-adminsdk-*.json
**/service-account*.json
**/serviceAccountKey*.json
!android/app/google-services.json
