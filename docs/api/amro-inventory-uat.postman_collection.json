{
  "info": {
    "name": "AMRO Inventory UAT - Reserve/Consume/Release/Reconcile/Scan",
    "_postman_id": "7b4f57d9-3d75-4de4-9fe5-3926ad53af90",
    "description": "Ready-to-run UAT collection for AMRO inventory integration workflows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Reconcile Inventory Health",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
          { "key": "X-Franchise-Id", "value": "{{franchiseId}}" }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v2/amro/inventory/work-order-sync?interface=reconcile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v2", "amro", "inventory", "work-order-sync"],
          "query": [{ "key": "interface", "value": "reconcile" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Interface is reconcile', function () {",
              "  pm.expect(body.interface).to.eql('amro-work-order-reconcile');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "2. Reserve Parts For Work Order",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
          { "key": "X-Franchise-Id", "value": "{{franchiseId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"part_number\": \"{{partNumber}}\",\n  \"quantity\": {{reserveQty}},\n  \"work_package_id\": \"{{workPackageId}}\",\n  \"task_id\": \"{{taskId}}\",\n  \"expires_at\": \"{{reservationExpiryIso}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v2/amro/inventory/work-order-sync?interface=reserve",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v2", "amro", "inventory", "work-order-sync"],
          "query": [{ "key": "interface", "value": "reserve" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Interface is reserve', function () {",
              "  pm.expect(body.interface).to.eql('amro-work-order-reserve');",
              "});",
              "pm.environment.set('reservationId', body.output.reservation_id || '');",
              "pm.environment.set('inventoryId', body.output.inventory_id || '');"
            ]
          }
        }
      ]
    },
    {
      "name": "3. Consume Reserved Parts",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
          { "key": "X-Franchise-Id", "value": "{{franchiseId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"part_number\": \"{{partNumber}}\",\n  \"quantity\": {{consumeQty}},\n  \"reservation_id\": \"{{reservationId}}\",\n  \"work_package_id\": \"{{workPackageId}}\",\n  \"task_id\": \"{{taskId}}\",\n  \"notes\": \"Auto-consumption from UAT flow\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v2/amro/inventory/work-order-sync?interface=consume",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v2", "amro", "inventory", "work-order-sync"],
          "query": [{ "key": "interface", "value": "consume" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Interface is consume', function () {",
              "  pm.expect(body.interface).to.eql('amro-work-order-consume');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "4. Release Reservation",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
          { "key": "X-Franchise-Id", "value": "{{franchiseId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"part_number\": \"{{partNumber}}\",\n  \"reservation_id\": \"{{reservationId}}\",\n  \"quantity\": {{releaseQty}},\n  \"work_package_id\": \"{{workPackageId}}\",\n  \"task_id\": \"{{taskId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v2/amro/inventory/work-order-sync?interface=release",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v2", "amro", "inventory", "work-order-sync"],
          "query": [{ "key": "interface", "value": "release" }]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Interface is release', function () {",
              "  pm.expect(body.interface).to.eql('amro-work-order-release');",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "5. Scan Receive (Barcode)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
          { "key": "X-Franchise-Id", "value": "{{franchiseId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scan_mode\": \"barcode\",\n  \"event_type\": \"receive\",\n  \"scan_code\": \"{{scanCode}}\",\n  \"quantity\": {{scanReceiveQty}},\n  \"scanner_device_id\": \"{{scannerDeviceId}}\",\n  \"ui_source\": \"postman-uat\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v2/amro/inventory/scan",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v2", "amro", "inventory", "scan"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Interface is scan', function () {",
              "  pm.expect(body.interface).to.eql('amro-inventory-scan');",
              "});",
              "pm.environment.set('scanEventId', body.output.scan_event_id || '');"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Scan Issue (Barcode)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{accessToken}}" },
          { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
          { "key": "X-Franchise-Id", "value": "{{franchiseId}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"scan_mode\": \"barcode\",\n  \"event_type\": \"issue\",\n  \"scan_code\": \"{{scanCode}}\",\n  \"quantity\": {{scanIssueQty}},\n  \"scanner_device_id\": \"{{scannerDeviceId}}\",\n  \"ui_source\": \"postman-uat\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/v2/amro/inventory/scan",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v2", "amro", "inventory", "scan"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status is 200', function () {",
              "  pm.response.to.have.status(200);",
              "});",
              "const body = pm.response.json();",
              "pm.test('Interface is scan', function () {",
              "  pm.expect(body.interface).to.eql('amro-inventory-scan');",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
