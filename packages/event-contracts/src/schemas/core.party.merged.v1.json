{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.local/event-contracts/core.party.merged.v1.json",
  "title": "core.party.merged v1",
  "description": "Emitted when two or more parties are consolidated into one. Consumers must re-link their references from deprecated_party_ids to merged_into_party_id.",
  "type": "object",
  "required": ["merged_into_party_id", "deprecated_party_ids", "merge_kind", "merged_by_user_id"],
  "additionalProperties": false,
  "properties": {
    "merged_into_party_id": { "type": "string", "format": "uuid" },
    "deprecated_party_ids": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "format": "uuid" },
      "uniqueItems": true
    },
    "merge_kind": {
      "type": "string",
      "enum": ["manual_human", "ai_suggested_human_approved", "import_dedup"]
    },
    "merged_by_user_id": { "type": ["string", "null"], "format": "uuid" },
    "ai_invocation_id": {
      "type": ["string", "null"],
      "description": "ULID of the core.llm_invocations row that suggested this merge, if applicable. Closes the AI-outcome loop."
    }
  }
}
