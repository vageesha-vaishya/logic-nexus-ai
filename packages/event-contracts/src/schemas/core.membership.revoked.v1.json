{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.local/event-contracts/core.membership.revoked.v1.json",
  "title": "core.membership.revoked v1",
  "description": "Emitted when a user loses access to one or more modules. Triggers cache invalidations and session-revocation in downstream modules.",
  "type": "object",
  "required": ["user_id", "module_codes", "revoked_by_user_id", "reason"],
  "additionalProperties": false,
  "properties": {
    "user_id": { "type": "string", "format": "uuid" },
    "role_id": { "type": ["string", "null"], "format": "uuid" },
    "module_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "core", "crm", "sales", "quotation", "logistics",
          "finance", "compliance", "comms", "amro", "uim", "markets"
        ]
      },
      "uniqueItems": true
    },
    "revoked_by_user_id": { "type": "string", "format": "uuid" },
    "reason": {
      "type": "string",
      "enum": [
        "admin_action",
        "subscription_downgrade",
        "subscription_cancelled",
        "tenant_suspended",
        "policy_violation",
        "user_left_tenant"
      ]
    }
  }
}
