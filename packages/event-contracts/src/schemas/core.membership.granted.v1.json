{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.local/event-contracts/core.membership.granted.v1.json",
  "title": "core.membership.granted v1",
  "description": "Emitted when a user gains access to one or more modules within a tenant.",
  "type": "object",
  "required": ["user_id", "module_codes", "granted_by_user_id"],
  "additionalProperties": false,
  "properties": {
    "user_id": { "type": "string", "format": "uuid" },
    "role_id": { "type": ["string", "null"], "format": "uuid" },
    "module_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "core", "crm", "sales", "quotation", "logistics",
          "finance", "compliance", "comms", "amro", "uim", "markets"
        ]
      },
      "uniqueItems": true
    },
    "granted_by_user_id": { "type": "string", "format": "uuid" },
    "granted_via": {
      "type": "string",
      "enum": ["admin_ui", "subscription_change", "invitation_acceptance", "sso_jit"]
    }
  }
}
