{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.local/llm-prompts/amro.aog.triage.v1.json",
  "title": "amro.aog.triage output v1",
  "type": "object",
  "required": [
    "priority", "priority_rationale", "estimated_recovery_hours",
    "blocks_revenue_service", "recommended_actions", "parts_to_preorder",
    "escalation_chain", "alternate_recovery_options", "mel_recommendation",
    "safety_flags", "confidence"
  ],
  "additionalProperties": false,
  "properties": {
    "priority": {
      "type": "string",
      "enum": ["P1_AOG_CRITICAL", "P2_AOG_URGENT", "P3_AOG_PLANNED", "P4_DEFER_MEL"]
    },
    "priority_rationale": { "type": "string", "minLength": 1 },
    "estimated_recovery_hours": { "type": "number", "minimum": 0 },
    "blocks_revenue_service": { "type": "boolean" },
    "recommended_actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["action", "owner_role", "deadline_hours_from_now", "blocking"],
        "additionalProperties": false,
        "properties": {
          "action": { "type": "string", "minLength": 1 },
          "owner_role": {
            "type": "string",
            "enum": ["ops_controller", "maintenance_lead", "stores", "procurement", "vendor_coordinator"]
          },
          "deadline_hours_from_now": { "type": "number", "minimum": 0 },
          "blocking": { "type": "boolean" }
        }
      }
    },
    "parts_to_preorder": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["part_number", "qty", "rationale", "available_at_airport"],
        "additionalProperties": false,
        "properties": {
          "part_number": { "type": "string", "minLength": 1 },
          "qty": { "type": "integer", "minimum": 1 },
          "rationale": { "type": "string", "minLength": 1 },
          "available_at_airport": { "type": "boolean" }
        }
      }
    },
    "escalation_chain": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1 }
    },
    "alternate_recovery_options": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "mel_recommendation": {
      "type": "object",
      "required": ["consider_mel", "rationale"],
      "additionalProperties": false,
      "properties": {
        "consider_mel": { "type": "boolean" },
        "mel_category": { "type": ["string", "null"], "enum": ["A", "B", "C", "D", null] },
        "rationale": { "type": "string", "minLength": 1 }
      }
    },
    "safety_flags": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
