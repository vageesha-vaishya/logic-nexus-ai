{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.local/llm-prompts/amro.directive.applicability.v1.json",
  "title": "amro.directive.applicability output v1",
  "type": "object",
  "required": ["applies", "confidence", "reasoning", "matched_criteria", "unmatched_criteria", "ata_chapters_touched", "recommended_followup"],
  "additionalProperties": false,
  "properties": {
    "applies": { "type": "boolean" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "reasoning": { "type": "string", "minLength": 1 },
    "matched_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "unmatched_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "ata_chapters_touched": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_followup": { "type": "string", "minLength": 1 }
  }
}
