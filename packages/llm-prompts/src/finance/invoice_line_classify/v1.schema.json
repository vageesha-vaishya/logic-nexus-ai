{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://platform.local/llm-prompts/finance.invoice.line_classify.v1.json",
  "title": "finance.invoice.line_classify output v1",
  "type": "object",
  "required": ["classifications", "unclassified_lines", "warnings", "confidence"],
  "additionalProperties": false,
  "properties": {
    "classifications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "line_id",
          "gl_account_code",
          "gl_account_name",
          "gl_account_type",
          "is_pass_through",
          "applies_tax",
          "tax_code",
          "tax_rate_pct",
          "tax_treatment",
          "rationale",
          "confidence"
        ],
        "additionalProperties": false,
        "properties": {
          "line_id": { "type": "string", "minLength": 1 },
          "gl_account_code": { "type": "string", "minLength": 1, "maxLength": 32 },
          "gl_account_name": { "type": "string", "maxLength": 120 },
          "gl_account_type": {
            "type": "string",
            "enum": [
              "revenue",
              "cost_of_sales",
              "expense",
              "pass_through_liability",
              "tax_payable",
              "tax_receivable",
              "other"
            ]
          },
          "is_pass_through": { "type": "boolean" },
          "applies_tax": { "type": "boolean" },
          "tax_code": { "type": ["string", "null"], "maxLength": 32 },
          "tax_rate_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 },
          "tax_treatment": {
            "type": "string",
            "enum": ["standard", "zero_rated", "exempt", "reverse_charge", "out_of_scope"]
          },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 280 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "unclassified_lines": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["line_id", "reason"],
        "additionalProperties": false,
        "properties": {
          "line_id": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 280 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "maxLength": 240 }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  }
}
