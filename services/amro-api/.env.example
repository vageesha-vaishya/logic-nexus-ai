# AMRO API Server Configuration

# Server
PORT=3001
NODE_ENV=development

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
AMRO_SUPABASE_URL=https://your-project.supabase.co
AMRO_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS
CORS_ORIGIN=http://localhost:8083

# Optional environment profile
APP_ENV=dev

# Kafka Configuration
# Broker connections (comma-separated)
KAFKA_BROKERS=localhost:9092

# Topic names (pre-created by ops/infra)
KAFKA_TOPIC_WORK_ORDERS=amro.work-orders
KAFKA_TOPIC_TASKS=amro.tasks

# Kafka Client Configuration
KAFKA_CLIENT_ID=amro-api-producer
KAFKA_PRODUCER_TIMEOUT=5000

# Debug
DEBUG=false
