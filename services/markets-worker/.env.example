# markets-worker — required environment variables
# Copy to .env and fill values. Never commit .env.

# Supabase (use service-role key — worker runs server-side only)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-jwt-secret

# LLM providers
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Redis for RQ job queue
# Option A: Upstash (same instance as Edge Function rate limiter)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
# Option B: local Redis (dev)
REDIS_URL=redis://localhost:6379/0

# Worker settings
WORKER_CONCURRENCY=4
JOB_TIMEOUT=300
ENVIRONMENT=development
LOG_LEVEL=INFO
