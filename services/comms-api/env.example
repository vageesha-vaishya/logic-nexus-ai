# Phase 6 comms-api — required + optional environment variables.
#
# Copy to .env and fill in the live values for your deployment. The
# service boots even when the secret-dependent vars are unset (HTTP
# /health stays up; the dispatcher and worker log a startup WARN and
# skip the loop until the secrets land). This lets the orchestrator
# health-check pass during partial rollouts.

# ── Required for the dispatcher + worker to actually do work ─────────
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Provider selection — flips NullEmailProvider → real send ─────────
# Leave unset (or set to anything other than 'resend') to keep the
# NullEmailProvider running. Useful for staging where the loop should
# exercise without actually sending.
COMMS_EMAIL_PROVIDER=resend
RESEND_API_KEY=re_...
# RFC 8058 List-Unsubscribe URL gets prefixed with this. Must be HTTPS
# and reachable from recipient mailboxes (Gmail/Yahoo enforce in 2024+).
COMMS_PUBLIC_BASE_URL=https://sosservices.online
# The default From header. Domain must be verified in Resend (or your
# SES/SMTP equivalent). sosservices.online is verified in Resend
# ap-south-1 per project memory.
COMMS_DEFAULT_FROM=SOS Logistics <notifications@sosservices.online>

# ── SMS provider (Phase 6 SMS slice) ─────────────────────────────────
# Real Twilio implementation lands in the next slice. For now the
# delivery-worker still routes channel_kind=sms rows through the
# provider abstraction; with COMMS_SMS_PROVIDER unset (or any value
# other than 'twilio') the NullSmsProvider returns
# permanent=true + a descriptive error_text so rows land in
# status='failed' rather than retrying forever.
#
# COMMS_SMS_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=...
# COMMS_SMS_DEFAULT_FROM=+14155551234

# ── WhatsApp provider (Phase 6 WhatsApp slice) ───────────────────────
# Twilio's WhatsApp Business runs on the same TWILIO_ACCOUNT_SID /
# TWILIO_AUTH_TOKEN as SMS; only the from-number differs (must be a
# WhatsApp-enabled sender in your Twilio console). With
# COMMS_WHATSAPP_PROVIDER unset (or any value other than 'twilio')
# the NullWhatsappProvider returns permanent=true + descriptive
# error_text so rows land in status='failed'.
#
# Session messages (text within 24h of a user-initiated message) go
# as plain body. Business-initiated messages outside that window
# require a pre-approved Twilio Content SID — set
# OutboundWhatsapp.templateName at the call site to switch.
#
# COMMS_WHATSAPP_PROVIDER=twilio
# COMMS_WHATSAPP_DEFAULT_FROM=+14155238886

# ── Resend webhook receiver — Svix HMAC-SHA256 signing key ───────────
# Get from the Resend dashboard's webhook setup screen. Point the
# webhook endpoint at <COMMS_PUBLIC_BASE_URL>/api/comms/webhooks/resend.
# Without this set the receiver returns 503; with it set every event
# is signature-verified before any DB write.
COMMS_RESEND_WEBHOOK_SECRET=whsec_...

# ── Tunables (defaults sane for prod) ────────────────────────────────
COMMS_API_PORT=3601
COMMS_DISPATCHER_POLL_INTERVAL_MS=5000
COMMS_DISPATCHER_BATCH_SIZE=50
COMMS_WORKER_POLL_INTERVAL_MS=5000
COMMS_WORKER_BATCH_SIZE=20

# ── CORS — restrict to the platform's frontend origins ───────────────
CORS_ORIGIN=https://logicnexus.example,https://sosservices.online
