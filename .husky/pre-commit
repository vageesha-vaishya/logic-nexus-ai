#!/usr/bin/env sh

# Block commits containing secrets
if command -v gitleaks &> /dev/null; then
  gitleaks protect --staged --config .gitleaks.toml --redact
  if [ $? -ne 0 ]; then
    echo ""
    echo "  Gitleaks detected potential secrets in staged files."
    echo "  Remove the secrets and try again."
    echo "  To skip (DANGEROUS): git commit --no-verify"
    echo ""
    exit 1
  fi
else
  echo "Warning: gitleaks not found. Install it: brew install gitleaks"
fi
